# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Connection URI (Optional: Leave empty or omit to use JSON-file database mode)
MONGODB_URI=mongodb://localhost:27017/zynero

# Razorpay API Credentials (From Razorpay Dashboard)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# CORS Allowed Origin (Optional)
# CLIENT_ORIGIN=http://localhost:5000
